# 이 작업 폴더에는 과거 실험도 있습니다. Phase 1 배포 항목만 추적합니다.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/pyproject.toml
!/requirements/
!/configs/
!/scripts/
!/src/
!/tests/
!/tutorials/
!/docs/
!/data/
!/artifacts/
!/paper/

# 현재 양청도드리 피리 pipeline에 필요한 원본 악보만 포함합니다.
/data/*
!/data/README.md
!/data/02 Cheon-Yangcheongdodeuri_musicxml_1-6/
!/data/02 Cheon-Yangcheongdodeuri_musicxml_7/
/data/02 Cheon-Yangcheongdodeuri_musicxml_1-6/*
/data/02 Cheon-Yangcheongdodeuri_musicxml_7/*
!/data/02 Cheon-Yangcheongdodeuri_musicxml_1-6/*Piri*.xml*
!/data/02 Cheon-Yangcheongdodeuri_musicxml_7/*Piri*.xml*

# Frozen input과 integration test용 legacy Checkpoint를 포함합니다.
/artifacts/*
!/artifacts/README.md
!/artifacts/release_manifest.json
!/artifacts/measures_v0.json
!/artifacts/vocabulary_v0.json
!/artifacts/phrase_graph_v0.json
!/artifacts/m2_denoiser_v0.pt

# 허용한 directory 안에서도 local 환경, cache, secret, output은 제외합니다.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
.DS_Store
._*
.env
.env.*
!.env.example
*.pem
*.key
*.bak
*.tmp
